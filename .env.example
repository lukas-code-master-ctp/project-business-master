# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxx

# OpenRouter (proveedor unificado de modelos IA)
# Crea tu key en https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxx

# Modelo IA por defecto (opcional)
# Algunas opciones recomendadas:
#   anthropic/claude-3.5-sonnet       (mejor calidad — default si no se setea)
#   openai/gpt-4o                     (alternativa fuerte)
#   google/gemini-2.0-flash-exp:free  (gratis durante beta)
#   deepseek/deepseek-chat            (ultra barato)
# AI_MODEL=anthropic/claude-3.5-sonnet

# URL pública del sitio (para attribution en OpenRouter)
# NEXT_PUBLIC_SITE_URL=https://tu-app.vercel.app
